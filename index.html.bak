        <link rel="stylesheet" href="assets/css/responsive.css">

        <!-- Title & SEO -->
        <title>DsMonkTech Web Solution — SEO &amp; Web Design Agency for Global Businesses</title>
        <meta name="description" content="DsMonkTech Web Solution is a full-service SEO and web design agency headquartered in Akbarpur, Uttar Pradesh, serving clients across India and worldwide — search engine optimization, website development, and white-label services.">
        <link rel="canonical" href="https://www.dsmonktech.com/">
        <meta property="og:type" content="website">
        <meta property="og:title" content="DsMonkTech Web Solution — SEO & Web Design Agency">
        <meta property="og:description" content="Search engine optimization, website development, and white-label services for businesses worldwide.">
        <meta property="og:url" content="https://www.dsmonktech.com/">

        <!-- Favicon -->
        <link rel="icon" type="image/png" href="assets/img/brand/favicon-dsmonktech.png">

        <!-- Structured Data -->
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": ["ProfessionalService", "LocalBusiness"],
          "name": "DsMonkTech Web Solution",
          "url": "https://www.dsmonktech.com/",
          "description": "Full-service SEO and web design agency headquartered in Akbarpur, Ambedkar Nagar, Uttar Pradesh, delivering search engine optimization, website development, and white-label digital marketing services to clients across India and worldwide.",
          "areaServed": ["Akbarpur", "Ambedkar Nagar", "Uttar Pradesh", "India", "Worldwide"],
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Akbarpur",
            "addressRegion": "Ambedkar Nagar, Uttar Pradesh",
            "postalCode": "224122",
            "addressCountry": "IN"
          },
          "geo": { "@type": "GeoCoordinates", "latitude": 26.4333, "longitude": 82.5403 },
          "email": "dsmonktech@gmail.com",
          "telephone": "+916394957703"
        }
        </script>
    </head>

